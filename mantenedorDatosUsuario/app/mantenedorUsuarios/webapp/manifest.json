{
	"_version": "1.60.0",
	"sap.app": {
		"id": "mantenedorDatosUsuario",
		"type": "application",
		"i18n": "i18n/i18n.properties",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",
		"dataSources": {
			"usuarioModel": {
				"uri": "/odata/v4/usuario/",
				"type": "OData",
				"settings": {
					"odataVersion": "4.0"
				}
			}
		}
	},
	"sap.ui": {
		"technology": "UI5",
		"icons": {
			"icon": "",
			"favIcon": ""
		},
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		}
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "mantenedorDatosUsuario.view.App",
			"type": "XML",
			"id": "app"
		},
		"dependencies": {
			"minUI5Version": "1.120.0",
			"libs": {
				"sap.ui.core": {},
				"sap.m": {}
			}
		},
		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "mantenedorDatosUsuario.i18n.i18n"
				}
			},
			"": {
				"dataSource": "usuarioModel",
				"type": "sap.ui.model.odata.v4.ODataModel",
				"settings": {
					"synchronizationMode": "None",
					"autoExpandSelect": true,
					"earlyRequests": true
				}
			}
		}
	}
}
