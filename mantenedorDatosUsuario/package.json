{
	"name": "mantenedordatosusuario",
	"version": "1.0.0",
	"private": true,
	"description": "Mantenedor CRUD de usuarios (SAPUI5 freestyle + CAP/CDS + SQLite, migrable a HANA)",
	"scripts": {
		"start": "cds watch"
	},
	"dependencies": {
		"@sap/cds": "^10",
		"@cap-js/sqlite": "^3"
	},
	"devDependencies": {
		"@sap/cds-dk": "^10"
	},
	"cds": {
		"requires": {
			"db": {
				"kind": "sqlite",
				"credentials": {
					"url": "db.sqlite"
				}
			}
		}
	}
}
