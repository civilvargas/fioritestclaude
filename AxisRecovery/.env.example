# Copia este archivo a ".env" si quieres personalizar el secreto de firma de sesión.
# No es obligatorio para correr el proyecto en local: si no se define, se usa un valor
# de desarrollo por defecto (ver srv/lib/auth.js). Cambiar este valor por uno propio y
# secreto es obligatorio antes de llevar el sitio a producción.
AXISRECOVERY_JWT_SECRET=cambia-este-valor-por-un-secreto-largo-y-aleatorio
