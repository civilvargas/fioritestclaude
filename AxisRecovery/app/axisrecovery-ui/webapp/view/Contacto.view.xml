<mvc:View
  controllerName="axisrecovery.ui.controller.Contacto"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
>
  <Page title="{i18n>contactoTitle}" showNavButton="false" class="arDarkPage">
    <FlexBox wrap="Wrap" class="sapUiSmallMargin">
      <VBox class="arCard sapUiTinyMargin" width="22rem">
        <Label text="{i18n>contactoNombre}" />
        <Input value="{ui>/nombre}" />
        <Label text="{i18n>contactoCorreo}" class="sapUiTinyMarginTop" />
        <Input value="{ui>/correo}" type="Email" />
        <Label text="{i18n>contactoCanal}" class="sapUiTinyMarginTop" />
        <Select selectedKey="{ui>/canalPreferido}" width="100%">
          <core:Item key="whatsapp" text="WhatsApp" />
          <core:Item key="correo" text="Correo" />
          <core:Item key="red_social" text="Redes sociales" />
        </Select>
        <Label text="{i18n>contactoMensaje}" class="sapUiTinyMarginTop" />
        <TextArea value="{ui>/mensaje}" rows="4" width="100%" />
        <Button
          text="{i18n>contactoEnviar}"
          type="Emphasized"
          class="arPrimaryBtn sapUiSmallMarginTop"
          press="onEnviar"
          width="12rem"
        />
      </VBox>

      <VBox class="arCard sapUiTinyMargin" width="20rem">
        <Image src="img/icon-contacto.png" alt="Contacto" class="arCardIcon" />
        <Title text="{i18n>contactoAccesosDirectos}" level="H3" />
        <Button
          text="{i18n>contactoWhatsapp}"
          icon="sap-icon://phone"
          type="Emphasized"
          class="arPrimaryBtn sapUiSmallMarginTop"
          press="onAbrirWhatsapp"
          width="100%"
        />
        <Text text="{i18n>contactoRedes}" class="sapUiSmallMarginTop" />
        <Text text="{i18n>contactoCentro}" class="sapUiTinyMarginTop" />
      </VBox>
    </FlexBox>

    <core:Fragment fragmentName="axisrecovery.ui.view.BeneficiosFooter" type="XML" />
  </Page>
</mvc:View>
