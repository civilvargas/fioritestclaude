<mvc:View
  controllerName="axisrecovery.ui.controller.App"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  displayBlock="true"
  height="100%"
>
  <VBox class="arRootFlex" height="100%" fitContainer="true">
    <OverflowToolbar id="navBar" class="arNavBar" design="Solid">
      <Image src="img/logo-wordmark.png" height="1.75rem" class="arBrandWordmark sapUiTinyMarginEnd" alt="AxisRecovery" />
      <Title text="AxisRecovery" level="H1" class="arBrand arVisuallyHidden" />
      <ToolbarSpacer />
      <Button text="{i18n>navHome}" press="onNavHome" type="Transparent" />
      <Button text="{i18n>navRecursos}" press="onNavRecursos" type="Transparent" />
      <Button text="{i18n>navApoyo}" press="onNavApoyo" type="Transparent" />
      <Button text="{i18n>navEspecialistas}" press="onNavEspecialistas" type="Transparent" />
      <Button text="{i18n>navComunidad}" press="onNavComunidad" type="Transparent" />
      <Button
        text="{i18n>navSeguimiento}"
        press="onNavSeguimiento"
        type="Transparent"
        visible="{session>/autenticado}"
      />
      <Button text="{i18n>navContacto}" press="onNavContacto" type="Transparent" />
      <Button
        text="{i18n>navAdmin}"
        press="onNavAdmin"
        type="Transparent"
        visible="{= ${session>/rol} === 'Administrador' }"
      />
      <HBox alignItems="Center" class="arSessionName" visible="{session>/autenticado}">
        <core:Icon src="sap-icon://customer" class="sapUiTinyMarginEnd" size="1rem" />
        <Text text="{session>/nombre}" />
      </HBox>
      <Button text="{i18n>navLogout}" press="onLogout" type="Transparent" visible="{session>/autenticado}" />
      <Button
        text="{i18n>navLogin}"
        press="onNavLogin"
        type="Emphasized"
        class="arPrimaryBtn"
        visible="{= !${session>/autenticado} }"
      />
    </OverflowToolbar>
    <App id="app" class="arAppFlex" />
  </VBox>
</mvc:View>
