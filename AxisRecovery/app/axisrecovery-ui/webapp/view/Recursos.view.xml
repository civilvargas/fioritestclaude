<mvc:View
  controllerName="axisrecovery.ui.controller.Recursos"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
>
  <Page showNavButton="false" class="arDarkPage">
    <customHeader>
      <Bar class="arPageHeaderBar">
        <contentLeft>
          <Image src="{ui>/iconoModulo}" class="arPageHeaderIcon" />
          <Title text="{ui>/titulo}" level="H2" />
        </contentLeft>
      </Bar>
    </customHeader>
    <MessageStrip
      text="{i18n>recursosAviso}"
      type="Information"
      showIcon="true"
      class="sapUiSmallMarginBottom arMsgAviso"
      visible="{ui>/esApoyo}"
    />
    <Toolbar>
      <Label text="{i18n>recursosFiltroCategoria}" class="sapUiTinyMarginEnd" />
      <Select
        forceSelection="false"
        selectedKey="{ui>/categoriaFiltro}"
        change="onFiltrar"
        items="{ui>/categoriaOpciones}"
        width="14rem"
      >
        <core:Item key="{ui>key}" text="{ui>text}" />
      </Select>
      <ToolbarSpacer />
      <Button
        text="{i18n>recursosVerEspecialistas}"
        type="Transparent"
        press="onVerEspecialistas"
        visible="{ui>/esApoyo}"
      />
    </Toolbar>
    <List items="{ui>/recursos}" noDataText="{i18n>recursosSinResultados}">
      <CustomListItem
        type="{= !!${ui>urlContenido} ? 'Active' : 'Inactive' }"
        press="onAbrirRecurso"
      >
        <VBox class="arCard sapUiTinyMargin">
          <HBox justifyContent="SpaceBetween">
            <HBox alignItems="Center">
              <Image src="{path: 'ui>tipo', formatter: '.formatTipoIcon'}" class="arCardIcon arCardIconSmall sapUiTinyMarginEnd" />
              <Title text="{ui>titulo}" level="H3" />
            </HBox>
            <ObjectStatus text="{ui>tipo}" state="Information" />
          </HBox>
          <Image src="{ui>imagenUrl}" class="arResourceImage sapUiTinyMarginTop" visible="{= !!${ui>imagenUrl} }" />
          <Text text="{ui>descripcion}" class="sapUiTinyMarginTop" />
          <Text text="{ui>autor}" class="sapUiTinyMarginTop" />
          <Link
            text="Abrir recurso"
            visible="{= !!${ui>urlContenido} }"
            class="sapUiTinyMarginTop"
          />
        </VBox>
      </CustomListItem>
    </List>

    <core:Fragment fragmentName="axisrecovery.ui.view.BeneficiosFooter" type="XML" />
  </Page>
</mvc:View>
